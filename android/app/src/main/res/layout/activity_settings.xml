<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#020617">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#0b1220">

        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_gear"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/settings_activity_title"
            android:textColor="#e2e8f0"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- 模型与服务商 -->
            <TextView
                style="@style/SettingsSectionTitle"
                android:text="@string/settings_model_section" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#0b1220"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#1e293b"
                app:strokeWidth="1dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView style="@style/SettingsLabel" android:text="@string/settings_provider" />
                    <Spinner
                        android:id="@+id/providerSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_settings_button"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                    <TextView style="@style/SettingsLabel" android:text="@string/settings_model" />
                    <Spinner
                        android:id="@+id/modelSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_settings_button"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/customModelLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/settings_custom_model_hint"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="#0f172a"
                        app:hintTextColor="#64748b"
                        app:android:textColorHint="#64748b"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/customModelInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#e2e8f0"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView style="@style/SettingsLabel" android:text="@string/settings_api_key" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/settings_api_key_hint"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="#0f172a"
                        app:hintTextColor="#64748b"
                        app:passwordToggleEnabled="true"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/apiKeyInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#e2e8f0"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView style="@style/SettingsLabel" android:text="@string/settings_base_url" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/baseUrlLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/settings_base_url_hint"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="#0f172a"
                        app:hintTextColor="#64748b"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/baseUrlInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#e2e8f0"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView style="@style/SettingsLabel" android:text="@string/settings_endpoint_type" />
                    <RadioGroup
                        android:id="@+id/endpointGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:visibility="gone">

                        <RadioButton
                            android:id="@+id/endpointChat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_endpoint_chat"
                            android:textColor="#cbd5e1"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/endpointResponses"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_endpoint_responses"
                            android:textColor="#cbd5e1"
                            android:textSize="13sp" />
                    </RadioGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <Button
                            android:id="@+id/saveBtn"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/settings_save_restart"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/testBtn"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/settings_test"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 外观 -->
            <TextView
                style="@style/SettingsSectionTitle"
                android:text="@string/settings_appearance_section" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#0b1220"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#1e293b"
                app:strokeWidth="1dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView style="@style/SettingsLabel" android:text="@string/settings_theme" />
                    <Spinner
                        android:id="@+id/themeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_settings_button"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 诊断与关于 -->
            <TextView
                style="@style/SettingsSectionTitle"
                android:text="@string/settings_section_diag" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#0b1220"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#1e293b"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/diagText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#94a3b8"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />

                    <Button
                        android:id="@+id/resetBtn"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="重置运行环境"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
